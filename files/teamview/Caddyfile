{
    admin off
    servers {
        metrics
    }
}

:9091 {
    metrics /metrics
}

:80 {
  redir https://{host}{uri} permanent
}

:443 {
  tls /cert.pem /key.pem
  reverse_proxy teamview:3000

  handle_errors {
    # This block runs automatically for ANY 4xx/5xx generated by handlers
    root * /srv/frozen
    rewrite * /index.html
    file_server
  }
}